<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="gnome-shell-extension-pingindicatorplusplus">
  <schema id="org.gnome.shell.extensions.pingindicatorplusplus" path="/org/gnome/shell/extensions/pingindicatorplusplus/">
    <key name="ping-destination" type="s">
      <default>'8.8.8.8'</default>
    </key>
    <key name="ping-destination-v4" type="s">
      <default>'8.8.8.8'</default>
    </key>
    <key name="ping-destination-v6" type="s">
      <default>'2001:4860:4860::8888'</default>
    </key>
    <key name="ping-mode" type="s">
      <choices>
        <choice value="ipv4" />
        <choice value="ipv6" />
        <choice value="both" />
      </choices>
      <default>'both'</default>
    </key>
    <key name="show-protocol-status" type="b">
      <default>true</default>
    </key>
    <key name="retry-interval" type="i">
      <range min="5" max="300" />
      <default>30</default>
    </key>
    <key name="refresh-interval" type="i">
      <default>2</default>
    </key>
    <key name="failure-timeout" type="i">
      <default>10</default>
    </key>
    <key name="beep-when-timeout" type="b">
      <default>false</default>
    </key>
    <key name="enable-color-on-failure" type="b">
      <default>true</default>
    </key>
    <key name="color-on-failure" type="s">
      <default>'#ff0000'</default>
    </key>
  </schema>
</schemalist>
